{
  "name": "sath-escritorio",
  "version": "2.0.0",
  "description": "Formularios SATH y Escaneos Pro: edición A4, autocompletado y documentos locales para Windows",
  "private": true,
  "author": "Andrenelly",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/ui.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test:ui:v2": "node test/ui-v2.cjs",
    "test:packaged": "node test/packaged.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "pe.andrenelly.sath",
    "productName": "SATH Escritorio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SATH-Escritorio-${version}-Instalador.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "script": "build/windows.nsi"
    }
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
